# KeeperFX Editor prefab. The format is described in the kfx-prefab crate (model.rs).
format = 1
thumbnail = ""

[meta]
name = "Barracks and guard post"
author = "KeeperFX Editor starter set"
description = "A barracks with a guard post row in front of its door."
tags = ["barracks", "guard", "rooms", "doors"]
editor_version = "0.1.0"

[meta.requires]
creatures = []
objects = []
traps = []
doors = ["WOOD"]
effect_generators = []
slabs = ["BARRACK_AREA", "BARRACK_WALL", "DIRT", "DOOR_WOODEN2", "GUARD_AREA", "PAIR_WALL", "PATH", "TORCH_WALL", "TWINS_WALL", "WOMAN_WALL"]
config = []

[layout]
width = 11
height = 8
rows = [
  ":::::::::::",
  ":WwwwwwwwA:",
  ":wRRRRRRRw:",
  ":wRRRRRRRw:",
  ":AwwwDwwwA:",
  ":BUUUUUUUC:",
  ":BACBDCWAC:",
  ":::::_:::::",
]

[[palette]]
char = ":"
slab = "DIRT"
owner = "neutral"

[[palette]]
char = "W"
slab = "TORCH_WALL"
owner = "A"

[[palette]]
char = "w"
slab = "BARRACK_WALL"
owner = "A"

[[palette]]
char = "A"
slab = "PAIR_WALL"
owner = "A"

[[palette]]
char = "R"
slab = "BARRACK_AREA"
owner = "A"

[[palette]]
char = "D"
slab = "DOOR_WOODEN2"
owner = "A"

[[palette]]
char = "B"
slab = "TWINS_WALL"
owner = "A"

[[palette]]
char = "U"
slab = "GUARD_AREA"
owner = "A"

[[palette]]
char = "C"
slab = "WOMAN_WALL"
owner = "A"

[[palette]]
char = "_"
slab = "PATH"
owner = "neutral"

[[thing]]
class = "Door"
model = "WOOD"
owner = "A"
x = [16, 128]
y = [13, 128]
door_orientation = 0
door_locked = false

[[thing]]
class = "Door"
model = "WOOD"
owner = "A"
x = [16, 128]
y = [19, 128]
door_orientation = 0
door_locked = false
