# KeeperFX Editor prefab. The format is described in the kfx-prefab crate (model.rs).
format = 1
thumbnail = ""

[meta]
name = "Neutral den: orc camp"
author = "KeeperFX Editor starter set"
description = "A rock camp with three wild orcs and some barrels."
tags = ["neutral", "den", "creatures"]
editor_version = "0.1.0"

[meta.requires]
creatures = ["ORC"]
objects = ["BARREL"]
traps = []
doors = []
effect_generators = []
slabs = ["HARD", "PATH"]
config = []

[layout]
width = 11
height = 8
rows = [
  "..#######..",
  ".#_______#.",
  "#_________#",
  "#_________#",
  "#_________#",
  "#_________#",
  ".#_______#.",
  "..###_###..",
]

[[palette]]
char = "#"
slab = "HARD"
owner = "neutral"

[[palette]]
char = "_"
slab = "PATH"
owner = "neutral"

[[thing]]
class = "Object"
model = "BARREL"
owner = "neutral"
x = [7, 128]
y = [7, 128]

[[thing]]
class = "Creature"
model = "ORC"
owner = "neutral"
x = [10, 128]
y = [10, 128]
level = 3

[[thing]]
class = "Creature"
model = "ORC"
owner = "neutral"
x = [22, 128]
y = [10, 128]
level = 3

[[thing]]
class = "Object"
model = "BARREL"
owner = "neutral"
x = [10, 128]
y = [16, 128]

[[thing]]
class = "Creature"
model = "ORC"
owner = "neutral"
x = [16, 128]
y = [16, 128]
level = 4

[[thing]]
class = "Object"
model = "BARREL"
owner = "neutral"
x = [25, 128]
y = [16, 128]
