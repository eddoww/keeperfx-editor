# KeeperFX Editor prefab. The format is described in the kfx-prefab crate (model.rs).
format = 1
thumbnail = ""

[meta]
name = "Hero fortress keep"
author = "KeeperFX Editor starter set"
description = "A walled keep with an outer steel gate, an inner wooden door and a ring corridor. The hero gate stands in the keep, guards in the courtyard. Hero owned (player 4)."
tags = ["hero", "fortress", "gate", "doors"]
editor_version = "0.1.0"

[meta.requires]
creatures = ["ARCHER", "BARBARIAN", "KNIGHT", "MONK", "WIZARD"]
objects = ["GUARDFLAG_WHITE", "HERO_GATE"]
traps = []
doors = ["STEEL", "WOOD"]
effect_generators = []
slabs = ["DOOR_STEEL2", "DOOR_WOODEN2", "DRAPE_WALL", "PAIR_WALL", "PRETTY_PATH", "TORCH_WALL", "TWINS_WALL", "WOMAN_WALL"]
config = []

[layout]
width = 13
height = 11
rows = [
  "WwABCAWABAAWw",
  "w-----------A",
  "w-CCAABBAWw-A",
  "A-A-------A-B",
  "A-C-------w-A",
  "B-A-------A-W",
  "B-WBAWDAWAB-W",
  "C-----------A",
  "C-----------A",
  "AWAAACdAWwBBA",
  "......-......",
]

[[palette]]
char = "W"
slab = "WOMAN_WALL"
owner = "keep:4"

[[palette]]
char = "w"
slab = "TORCH_WALL"
owner = "keep:4"

[[palette]]
char = "A"
slab = "PAIR_WALL"
owner = "keep:4"

[[palette]]
char = "B"
slab = "TWINS_WALL"
owner = "keep:4"

[[palette]]
char = "C"
slab = "DRAPE_WALL"
owner = "keep:4"

[[palette]]
char = "-"
slab = "PRETTY_PATH"
owner = "keep:4"

[[palette]]
char = "D"
slab = "DOOR_WOODEN2"
owner = "keep:4"

[[palette]]
char = "d"
slab = "DOOR_STEEL2"
owner = "keep:4"

[[thing]]
class = "Creature"
model = "WIZARD"
owner = "keep:4"
x = [4, 128]
y = [10, 128]
level = 3

