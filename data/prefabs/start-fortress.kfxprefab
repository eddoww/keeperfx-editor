# KeeperFX Editor prefab. The format is described in the kfx-prefab crate (model.rs).
format = 1
thumbnail = ""

[meta]
name = "Dungeon start: fortress"
author = "KeeperFX Editor starter set"
description = "A big heart hall with pillars, a wooden door north and a braced door south, four imps. Owner slot A."
tags = ["dungeon", "start", "heart", "doors"]
editor_version = "0.1.0"

[meta.requires]
creatures = ["IMP"]
objects = []
traps = []
doors = ["BRACED", "WOOD"]
effect_generators = []
slabs = ["DIRT", "DOOR_BRACE2", "DOOR_WOODEN2", "DRAPE_WALL", "GOLD", "HARD", "HEART_PEDESTAL", "PAIR_WALL", "PATH", "PRETTY_PATH", "TORCH_WALL", "TWINS_WALL", "WOMAN_WALL"]
config = []

[layout]
width = 17
height = 13
rows = [
  ":$::::::_::::::$:",
  ":WwAwwBwDwCBBwAC:",
  ":W-------------w:",
  ":w-#---------#-B:",
  ":w-------------w:",
  ":A-----HHH-----A:",
  ":A-----HHH-----w:",
  ":C-----HHH-----w:",
  ":C-------------B:",
  ":w-#---------#-W:",
  ":w-------------w:",
  ":BwwAwBwdwAwCBwA:",
  "::::::::_::::::::",
]

[[palette]]
char = ":"
slab = "DIRT"
owner = "neutral"

[[palette]]
char = "$"
slab = "GOLD"
owner = "neutral"

[[palette]]
char = "_"
slab = "PATH"
owner = "neutral"

[[palette]]
char = "W"
slab = "TORCH_WALL"
owner = "A"

[[palette]]
char = "w"
slab = "PAIR_WALL"
owner = "A"

[[palette]]
char = "A"
slab = "TWINS_WALL"
owner = "A"

[[palette]]
char = "B"
slab = "WOMAN_WALL"
owner = "A"

[[palette]]
char = "D"
slab = "DOOR_WOODEN2"
owner = "A"

[[palette]]
char = "C"
slab = "DRAPE_WALL"
owner = "A"

[[palette]]
char = "-"
slab = "PRETTY_PATH"
owner = "A"

[[palette]]
char = "#"
slab = "HARD"
owner = "neutral"

[[palette]]
char = "H"
slab = "HEART_PEDESTAL"
owner = "A"

[[palette]]
char = "d"
slab = "DOOR_BRACE2"
owner = "A"

[[thing]]
class = "Door"
model = "WOOD"
owner = "A"
x = [25, 128]
y = [4, 128]
door_orientation = 0
door_locked = false

[[thing]]
class = "Creature"
model = "IMP"
owner = "A"
x = [10, 128]
y = [7, 128]
level = 1

[[thing]]
class = "Creature"
model = "IMP"
owner = "A"
x = [40, 128]
y = [7, 128]
level = 1

[[thing]]
class = "Creature"
model = "IMP"
owner = "A"
x = [10, 128]
y = [31, 128]
level = 1

[[thing]]
class = "Creature"
model = "IMP"
owner = "A"
x = [40, 128]
y = [31, 128]
level = 1

[[thing]]
class = "Door"
model = "BRACED"
owner = "A"
x = [25, 128]
y = [34, 128]
door_orientation = 0
door_locked = false
