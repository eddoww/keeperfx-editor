# KeeperFX Editor prefab. The format is described in the kfx-prefab crate (model.rs).
format = 1
thumbnail = ""

[meta]
name = "Training hall"
author = "KeeperFX Editor starter set"
description = "A five by five training room with a braced door."
tags = ["training", "rooms", "doors"]
editor_version = "0.1.0"

[meta.requires]
creatures = []
objects = []
traps = []
doors = ["BRACED"]
effect_generators = []
slabs = ["DIRT", "DOOR_BRACE2", "DRAPE_WALL", "PAIR_WALL", "PATH", "TORCH_WALL", "TRAINING_AREA", "TRAINING_WALL"]
config = []

[layout]
width = 9
height = 9
rows = [
  ":::::::::",
  ":WwwwwwA:",
  ":wNNNNNw:",
  ":wNNNNNw:",
  ":wNNNNNw:",
  ":wNNNNNw:",
  ":wNNNNNw:",
  ":BwwDwwA:",
  "::::_::::",
]

[[palette]]
char = ":"
slab = "DIRT"
owner = "neutral"

[[palette]]
char = "W"
slab = "TORCH_WALL"
owner = "A"

[[palette]]
char = "w"
slab = "TRAINING_WALL"
owner = "A"

[[palette]]
char = "A"
slab = "PAIR_WALL"
owner = "A"

[[palette]]
char = "N"
slab = "TRAINING_AREA"
owner = "A"

[[palette]]
char = "B"
slab = "DRAPE_WALL"
owner = "A"

[[palette]]
char = "D"
slab = "DOOR_BRACE2"
owner = "A"

[[palette]]
char = "_"
slab = "PATH"
owner = "neutral"

[[thing]]
class = "Door"
model = "BRACED"
owner = "A"
x = [13, 128]
y = [22, 128]
door_orientation = 0
door_locked = false
