# KeeperFX Editor prefab. The format is described in the kfx-prefab crate (model.rs).
format = 1
thumbnail = ""

[meta]
name = "Bridge over lava"
author = "KeeperFX Editor starter set"
description = "A lava stream crossed by a bridge, with rock banks on both sides."
tags = ["bridge", "lava", "terrain"]
editor_version = "0.1.0"

[meta.requires]
creatures = []
objects = []
traps = []
doors = []
effect_generators = []
slabs = ["BRIDGE_FRAME", "HARD", "LAVA", "PATH"]
config = []

[layout]
width = 9
height = 9
rows = [
  "#########",
  "#_______#",
  "#_______#",
  "^^^^+^^^^",
  "^^^^+^^^^",
  "^^^^+^^^^",
  "#_______#",
  "#_______#",
  "#########",
]

[[palette]]
char = "#"
slab = "HARD"
owner = "neutral"

[[palette]]
char = "_"
slab = "PATH"
owner = "neutral"

[[palette]]
char = "^"
slab = "LAVA"
owner = "neutral"

[[palette]]
char = "+"
slab = "BRIDGE_FRAME"
owner = "neutral"
wlb = 1
