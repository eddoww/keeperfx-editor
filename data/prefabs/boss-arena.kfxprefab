# KeeperFX Editor prefab. The format is described in the kfx-prefab crate (model.rs).
format = 1
thumbnail = ""

[meta]
name = "Boss arena"
author = "KeeperFX Editor starter set"
description = "A round arena with lava in its corners, four lava pillars and a dragon in the middle; one way in from the south."
tags = ["boss", "arena", "lava", "creatures"]
editor_version = "0.1.0"

[meta.requires]
creatures = ["DRAGON"]
objects = ["LAVA_PILLAR"]
traps = []
doors = []
effect_generators = []
slabs = ["HARD", "LAVA", "PATH"]
config = []

[layout]
width = 13
height = 13
rows = [
  "....#####....",
  "..##_____##..",
  ".##^_____^##.",
  ".#^^_____^^#.",
  "#___________#",
  "#___________#",
  "#___________#",
  "#___________#",
  "#___________#",
  ".#^^_____^^#.",
  ".##^_____^##.",
  "..##_____##..",
  "....##_##....",
]

[[palette]]
char = "#"
slab = "HARD"
owner = "neutral"

[[palette]]
char = "_"
slab = "PATH"
owner = "neutral"

[[palette]]
char = "^"
slab = "LAVA"
owner = "neutral"

[[thing]]
class = "Object"
model = "LAVA_PILLAR"
owner = "neutral"
x = [13, 128]
y = [13, 128]

[[thing]]
class = "Object"
model = "LAVA_PILLAR"
owner = "neutral"
x = [25, 128]
y = [13, 128]

[[thing]]
class = "Creature"
model = "DRAGON"
owner = "neutral"
x = [19, 128]
y = [19, 128]
level = 8

[[thing]]
class = "Object"
model = "LAVA_PILLAR"
owner = "neutral"
x = [13, 128]
y = [25, 128]

[[thing]]
class = "Object"
model = "LAVA_PILLAR"
owner = "neutral"
x = [25, 128]
y = [25, 128]
