char = "B"
slab = "WOMAN_WALL"
owner = "A"

[[palette]]
char = "C"
slab = "HATCHERY_WALL"
owner = "A"

[[palette]]
char = "L"
slab = "LAIR_AREA"
owner = "A"

[[palette]]
char = "-"
slab = "PRETTY_PATH"
owner = "A"

[[palette]]
char = "Y"
slab = "HATCHERY"
owner = "A"

[[palette]]
char = "D"
slab = "DOOR_WOODEN"
owner = "A"

[[palette]]
char = "E"
slab = "TWINS_WALL"
owner = "A"

[[palette]]
char = "d"
slab = "DOOR_WOODEN2"
owner = "A"

[[palette]]
