# KeeperFX Editor prefab. The format is described in the kfx-prefab crate (model.rs).
format = 1
thumbnail = ""

[meta]
name = "Lairs and hatchery block"
author = "KeeperFX Editor starter set"
description = "Two lairs behind doors and a long hatchery along a claimed corridor, one door south."
tags = ["lair", "hatchery", "rooms", "doors"]
editor_version = "0.1.0"

[meta.requires]
creatures = []
objects = []
traps = []
doors = ["WOOD"]
effect_generators = []
slabs = ["DIRT", "DOOR_WOODEN", "DOOR_WOODEN2", "HATCHERY", "HATCHERY_WALL", "LAIR_AREA", "LAIR_WALL", "PAIR_WALL", "PATH", "PRETTY_PATH", "TORCH_WALL", "TWINS_WALL", "WOMAN_WALL"]
config = []

[layout]
width = 13
height = 11
rows = [
  ":::::::::::::",
  ":WwwwABCCCCB:",
  ":wLLLw-YYYYC:",
  ":wLLLD-YYYYC:",
  ":wLLLw-YYYYC:",
  ":EwwwA-YYYYC:",
  ":wLLLw-YYYYC:",
  ":wLLLD-YYYYC:",
  ":wLLLw-YYYYC:",
  ":AwwwAdCCCCE:",
  "::::::_::::::",
]

[[palette]]
char = ":"
slab = "DIRT"
owner = "neutral"

[[palette]]
char = "W"
slab = "TORCH_WALL"
owner = "A"

[[palette]]
char = "w"
slab = "LAIR_WALL"
owner = "A"

[[palette]]
char = "A"
slab = "PAIR_WALL"
owner = "A"

