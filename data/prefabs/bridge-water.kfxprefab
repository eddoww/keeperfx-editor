# KeeperFX Editor prefab. The format is described in the kfx-prefab crate (model.rs).
format = 1
thumbnail = ""

[meta]
name = "Bridge over a river"
author = "KeeperFX Editor starter set"
description = "A three slab wide river crossed by a one slab bridge between two paved banks."
tags = ["bridge", "water", "terrain"]
editor_version = "0.1.0"

[meta.requires]
creatures = []
objects = []
traps = []
doors = []
effect_generators = []
slabs = ["BRIDGE_FRAME", "HARD", "PATH", "WATER"]
config = []

[layout]
width = 9
height = 9
rows = [
  "#########",
  "#_______#",
  "#_______#",
  "~~~~+~~~~",
  "~~~~+~~~~",
  "~~~~+~~~~",
  "#_______#",
  "#_______#",
  "#########",
]

[[palette]]
char = "#"
slab = "HARD"
owner = "neutral"

[[palette]]
char = "_"
slab = "PATH"
owner = "neutral"

[[palette]]
char = "~"
slab = "WATER"
owner = "neutral"

[[palette]]
char = "+"
slab = "BRIDGE_FRAME"
owner = "neutral"
wlb = 2
