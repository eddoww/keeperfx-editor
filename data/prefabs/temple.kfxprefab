# KeeperFX Editor prefab. The format is described in the kfx-prefab crate (model.rs).
format = 1
thumbnail = ""

[meta]
name = "Temple"
author = "KeeperFX Editor starter set"
description = "A five by five temple pool with a door."
tags = ["temple", "rooms", "doors"]
editor_version = "0.1.0"

[meta.requires]
creatures = []
objects = []
traps = []
doors = ["WOOD"]
effect_generators = []
slabs = ["DIRT", "DOOR_WOODEN2", "DRAPE_WALL", "PAIR_WALL", "PATH", "TEMPLE_POOL", "TEMPLE_WALL", "TORCH_WALL"]
config = []

[layout]
width = 9
height = 9
rows = [
  ":::::::::",
  ":WwwwwwA:",
  ":wMMMMMw:",
  ":wMMMMMw:",
  ":wMMMMMw:",
  ":wMMMMMw:",
  ":wMMMMMw:",
  ":BwwDwwA:",
  "::::_::::",
]

[[palette]]
char = ":"
slab = "DIRT"
owner = "neutral"

[[palette]]
char = "W"
slab = "TORCH_WALL"
owner = "A"

[[palette]]
char = "w"
slab = "TEMPLE_WALL"
owner = "A"

[[palette]]
char = "A"
slab = "PAIR_WALL"
owner = "A"

[[palette]]
char = "M"
slab = "TEMPLE_POOL"
owner = "A"

[[palette]]
char = "B"
slab = "DRAPE_WALL"
owner = "A"

[[palette]]
char = "D"
slab = "DOOR_WOODEN2"
owner = "A"

[[palette]]
char = "_"
slab = "PATH"
owner = "neutral"

[[thing]]
class = "Door"
model = "WOOD"
owner = "A"
x = [13, 128]
y = [22, 128]
door_orientation = 0
door_locked = false
