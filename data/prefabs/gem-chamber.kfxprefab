# KeeperFX Editor prefab. The format is described in the kfx-prefab crate (model.rs).
format = 1
thumbnail = ""

[meta]
name = "Guarded gem chamber"
author = "KeeperFX Editor starter set"
description = "A rock vault lined with gems behind a secret door, guarded by two trolls and a demonspawn on a lightning trap."
tags = ["gems", "secret", "guards", "traps"]
editor_version = "0.1.0"

[meta.requires]
creatures = ["DEMONSPAWN", "TROLL"]
objects = []
traps = ["LIGHTNING"]
doors = ["SECRET"]
effect_generators = []
slabs = ["DIRT", "DOOR_SECRET2", "GEMS", "HARD", "PATH"]
config = []

[layout]
width = 11
height = 9
rows = [
  ":::::::::::",
  ":#########:",
  ":#*******#:",
  ":#_______#:",
  ":#_______#:",
  ":#_______#:",
  ":####D####:",
  ":::::_:::::",
  ":::::::::::",
]

[[palette]]
char = ":"
slab = "DIRT"
owner = "neutral"

[[palette]]
char = "#"
slab = "HARD"
owner = "neutral"

[[palette]]
char = "*"
slab = "GEMS"
owner = "neutral"

[[palette]]
char = "_"
slab = "PATH"
owner = "neutral"

[[palette]]
char = "D"
slab = "DOOR_SECRET2"
owner = "A"

[[thing]]
class = "Creature"
model = "DEMONSPAWN"
owner = "neutral"
x = [16, 128]
y = [10, 128]
level = 4

[[thing]]
class = "Creature"
model = "TROLL"
owner = "neutral"
x = [10, 128]
y = [13, 128]
level = 3

[[thing]]
class = "Creature"
model = "TROLL"
owner = "neutral"
x = [22, 128]
y = [13, 128]
level = 3

[[thing]]
class = "Trap"
model = "LIGHTNING"
owner = "A"
x = [16, 128]
y = [16, 128]

[[thing]]
class = "Door"
model = "SECRET"
owner = "A"
x = [16, 128]
y = [19, 128]
door_orientation = 0
door_locked = false
