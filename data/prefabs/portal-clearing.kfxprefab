# KeeperFX Editor prefab. The format is described in the kfx-prefab crate (model.rs).
format = 1
thumbnail = ""

[meta]
name = "Portal clearing"
author = "KeeperFX Editor starter set"
description = "A rock cavern with a three by three creature portal and openings north and south."
tags = ["portal", "entrance", "terrain"]
editor_version = "0.1.0"

[meta.requires]
creatures = []
objects = []
traps = []
doors = []
effect_generators = []
slabs = ["ENTRANCE_ZONE", "HARD", "PATH"]
config = []

[layout]
width = 9
height = 9
rows = [
  "..##_##..",
  ".#_____#.",
  "#_______#",
  "#__EEE__#",
  "#__EEE__#",
  "#__EEE__#",
  "#_______#",
  ".#_____#.",
  "..##_##..",
]

[[palette]]
char = "#"
slab = "HARD"
owner = "neutral"

[[palette]]
char = "_"
slab = "PATH"
owner = "neutral"

[[palette]]
char = "E"
slab = "ENTRANCE_ZONE"
owner = "neutral"
