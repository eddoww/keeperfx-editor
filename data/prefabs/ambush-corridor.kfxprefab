# KeeperFX Editor prefab. The format is described in the kfx-prefab crate (model.rs).
format = 1
thumbnail = ""

[meta]
name = "Ambush corridor"
author = "KeeperFX Editor starter set"
description = "A claimed corridor with an action point trigger in the middle and a hidden hero alcove behind a secret door. When a creature of player A reaches the trigger, a hero party pours out of the hero gate (script fragment included)."
tags = ["ambush", "script", "action-point", "hero", "gate"]
editor_version = "0.1.0"

[meta.requires]
creatures = []
objects = ["HERO_GATE"]
traps = []
doors = ["SECRET"]
effect_generators = []
slabs = ["DIRT", "DOOR_SECRET2", "DRAPE_WALL", "PAIR_WALL", "PATH", "PRETTY_PATH", "TORCH_WALL", "TWINS_WALL", "WOMAN_WALL"]
config = []

[layout]
width = 19
height = 7
rows = [
  ":::::::::::::::::::",
  ":::::::WWWwA:::::::",
  ":::::::B---C:::::::",
  ":WWWWAWWBDAWWBWAAW:",
  "_EEEEEEEEEEEEEEEEE_",
  ":BWWWWwAwAAWWACBCB:",
  ":::::::::::::::::::",
]

[[palette]]
char = ":"
slab = "DIRT"
owner = "neutral"

[[palette]]
char = "W"
slab = "PAIR_WALL"
owner = "A"

[[palette]]
char = "w"
slab = "DRAPE_WALL"
owner = "A"

[[palette]]
char = "A"
slab = "WOMAN_WALL"
owner = "A"

[[palette]]
char = "B"
slab = "TWINS_WALL"
owner = "A"

[[palette]]
char = "-"
slab = "PRETTY_PATH"
owner = "keep:4"

[[palette]]
char = "C"
slab = "TORCH_WALL"
owner = "A"

[[palette]]
char = "D"
slab = "DOOR_SECRET2"
owner = "A"

[[palette]]
char = "_"
slab = "PATH"
owner = "neutral"

[[palette]]
char = "E"
slab = "PRETTY_PATH"
owner = "A"

[[thing]]
class = "Object"
model = "HERO_GATE"
owner = "keep:4"
x = [28, 128]
y = [7, 128]
gate = "gate"

[[thing]]
class = "Door"
model = "SECRET"
owner = "A"
x = [28, 128]
y = [10, 128]
door_orientation = 0
door_locked = false

[[action_point]]
key = "trigger"
x = [28, 128]
y = [13, 128]
range = [3, 0]
number = 1

[script]
dk = '''
REM Ambush corridor: heroes leave the gate when a creature of the keeper reaches the trigger
CREATE_PARTY(AMBUSH{{ap.trigger}})
ADD_TO_PARTY(AMBUSH{{ap.trigger}}, KNIGHT, 3, 0, ATTACK_ENEMIES, 0)
ADD_TO_PARTY(AMBUSH{{ap.trigger}}, ARCHER, 3, 0, ATTACK_ENEMIES, 0)
ADD_TO_PARTY(AMBUSH{{ap.trigger}}, WIZARD, 2, 0, ATTACK_ENEMIES, 0)
IF_ACTION_POINT({{ap.trigger}}, {{player.A}})
	ADD_PARTY_TO_LEVEL(PLAYER_GOOD, AMBUSH{{ap.trigger}}, -{{gate.gate}}, 1)
ENDIF
'''
