# KeeperFX Editor prefab. The format is described in the kfx-prefab crate (model.rs).
format = 1
thumbnail = ""

[meta]
name = "Dungeon start: hall with exits"
author = "KeeperFX Editor starter set"
description = "A heart hall with an open doorway north and south, paths leading out, three imps. Owner slot A."
tags = ["dungeon", "start", "heart"]
editor_version = "0.1.0"

[meta.requires]
creatures = ["IMP"]
objects = []
traps = []
doors = []
effect_generators = []
slabs = ["DIRT", "DRAPE_WALL", "HEART_PEDESTAL", "PAIR_WALL", "PATH", "PRETTY_PATH", "TORCH_WALL", "TWINS_WALL", "WOMAN_WALL"]
config = []

[layout]
width = 13
height = 9
rows = [
  "::::::_::::::",
  ":WwAww-wwwBC:",
  ":W---------W:",
  ":w--HHH----w:",
  ":w--HHH----W:",
  ":A--HHH----w:",
  ":A---------A:",
  ":BCwAw-wwWAB:",
  "::::::_::::::",
]

[[palette]]
char = ":"
slab = "DIRT"
owner = "neutral"

[[palette]]
char = "_"
slab = "PATH"
owner = "neutral"

[[palette]]
char = "W"
slab = "TORCH_WALL"
owner = "A"

[[palette]]
char = "w"
slab = "PAIR_WALL"
owner = "A"

[[palette]]
char = "A"
slab = "TWINS_WALL"
owner = "A"

[[palette]]
char = "-"
slab = "PRETTY_PATH"
owner = "A"

[[palette]]
char = "B"
slab = "DRAPE_WALL"
owner = "A"

[[palette]]
char = "C"
slab = "WOMAN_WALL"
owner = "A"

[[palette]]
char = "H"
slab = "HEART_PEDESTAL"
owner = "A"

[[thing]]
class = "Creature"
model = "IMP"
owner = "A"
x = [7, 128]
y = [7, 128]
level = 1

[[thing]]
class = "Creature"
model = "IMP"
owner = "A"
x = [28, 128]
y = [10, 128]
level = 1

[[thing]]
class = "Creature"
model = "IMP"
owner = "A"
x = [19, 128]
y = [19, 128]
level = 1
