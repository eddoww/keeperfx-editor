# KeeperFX Editor prefab. The format is described in the kfx-prefab crate (model.rs).
format = 1
thumbnail = ""

[meta]
name = "Hero outpost: camp"
author = "KeeperFX Editor starter set"
description = "An open hero camp in a rock clearing: a hero gate, barbarians, monks and a dwarf around a flag. Hero owned (player 4)."
tags = ["hero", "outpost", "gate", "open"]
editor_version = "0.1.0"

[meta.requires]
creatures = ["BARBARIAN", "DWARFA", "MONK"]
objects = ["GUARDFLAG_WHITE", "HERO_GATE"]
traps = []
doors = []
effect_generators = []
slabs = ["HARD", "PRETTY_PATH"]
config = []

[layout]
width = 11
height = 9
rows = [
  "...#####...",
  "..#-----#..",
  ".#-------#.",
  "#---------#",
  "#---------#",
  "#---------#",
  ".#-------#.",
  "..#-----#..",
  "...##-##...",
]

[[palette]]
char = "#"
slab = "HARD"
owner = "neutral"

[[palette]]
char = "-"
slab = "PRETTY_PATH"
owner = "keep:4"

[[thing]]
class = "Object"
model = "GUARDFLAG_WHITE"
owner = "keep:4"
x = [16, 128]
y = [7, 128]

[[thing]]
class = "Creature"
model = "BARBARIAN"
owner = "keep:4"
x = [10, 128]
y = [10, 128]
level = 3

[[thing]]
class = "Creature"
model = "BARBARIAN"
owner = "keep:4"
x = [22, 128]
y = [10, 128]
level = 3

[[thing]]
class = "Object"
model = "HERO_GATE"
owner = "keep:4"
x = [16, 128]
y = [13, 128]
gate = "gate"

[[thing]]
class = "Creature"
model = "MONK"
owner = "keep:4"
x = [10, 128]
y = [16, 128]
level = 2

[[thing]]
class = "Creature"
model = "MONK"
owner = "keep:4"
x = [22, 128]
y = [16, 128]
level = 2

[[thing]]
class = "Creature"
model = "DWARFA"
owner = "keep:4"
x = [16, 128]
y = [19, 128]
level = 2
