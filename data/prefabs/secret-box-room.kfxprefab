# KeeperFX Editor prefab. The format is described in the kfx-prefab crate (model.rs).
format = 1
thumbnail = ""

[meta]
name = "Secret special-box room"
author = "KeeperFX Editor starter set"
description = "A rock room behind a secret door holding five special boxes: reveal map, hidden world, increase level, resurrect creature and heal all."
tags = ["secret", "special", "treasure"]
editor_version = "0.1.0"

[meta.requires]
creatures = []
objects = ["SPECBOX_HEALALL", "SPECBOX_HIDNWRL", "SPECBOX_INCLEV", "SPECBOX_RESURCT", "SPECBOX_REVMAP"]
traps = []
doors = ["SECRET"]
effect_generators = []
slabs = ["DIRT", "DOOR_SECRET2", "HARD", "PATH"]
config = []

[layout]
width = 9
height = 7
rows = [
  ":::::::::",
  ":#######:",
  ":#_____#:",
  ":#_____#:",
  ":#_____#:",
  ":###D###:",
  "::::_::::",
]

[[palette]]
char = ":"
slab = "DIRT"
owner = "neutral"

[[palette]]
char = "#"
slab = "HARD"
owner = "neutral"

[[palette]]
char = "_"
slab = "PATH"
owner = "neutral"

[[palette]]
char = "D"
slab = "DOOR_SECRET2"
owner = "A"

[[thing]]
class = "Object"
model = "SPECBOX_REVMAP"
owner = "neutral"
x = [7, 128]
y = [7, 128]

[[thing]]
class = "Object"
model = "SPECBOX_HIDNWRL"
owner = "neutral"
x = [10, 128]
y = [7, 128]

[[thing]]
class = "Object"
model = "SPECBOX_RESURCT"
owner = "neutral"
x = [16, 128]
y = [7, 128]

[[thing]]
class = "Object"
model = "SPECBOX_HEALALL"
owner = "neutral"
x = [19, 128]
y = [7, 128]

[[thing]]
class = "Object"
model = "SPECBOX_INCLEV"
owner = "neutral"
x = [13, 128]
y = [10, 128]

[[thing]]
class = "Door"
model = "SECRET"
owner = "A"
x = [13, 128]
y = [16, 128]
door_orientation = 0
door_locked = false
