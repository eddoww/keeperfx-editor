# KeeperFX Editor prefab. The format is described in the kfx-prefab crate (model.rs).
format = 1
thumbnail = ""

[meta]
name = "Graveyard"
author = "KeeperFX Editor starter set"
description = "A five by four graveyard with a door."
tags = ["graveyard", "rooms", "doors"]
editor_version = "0.1.0"

[meta.requires]
creatures = []
objects = []
traps = []
doors = ["WOOD"]
effect_generators = []
slabs = ["DIRT", "DOOR_WOODEN2", "GRAVE_AREA", "GRAVE_WALL", "PAIR_WALL", "PATH", "TORCH_WALL", "TWINS_WALL"]
config = []

[layout]
width = 9
height = 8
rows = [
  ":::::::::",
  ":WwwwwwA:",
  ":wGGGGGw:",
  ":wGGGGGw:",
  ":wGGGGGw:",
  ":wGGGGGw:",
  ":BwwDwwW:",
  "::::_::::",
]

[[palette]]
char = ":"
slab = "DIRT"
owner = "neutral"

[[palette]]
char = "W"
slab = "TORCH_WALL"
owner = "A"

[[palette]]
char = "w"
slab = "GRAVE_WALL"
owner = "A"

[[palette]]
char = "A"
slab = "PAIR_WALL"
owner = "A"

[[palette]]
char = "G"
slab = "GRAVE_AREA"
owner = "A"

[[palette]]
char = "B"
slab = "TWINS_WALL"
owner = "A"

[[palette]]
char = "D"
slab = "DOOR_WOODEN2"
owner = "A"

[[palette]]
char = "_"
slab = "PATH"
owner = "neutral"

[[thing]]
class = "Door"
model = "WOOD"
owner = "A"
x = [13, 128]
y = [19, 128]
door_orientation = 0
door_locked = false
