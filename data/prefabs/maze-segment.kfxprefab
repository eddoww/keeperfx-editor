# KeeperFX Editor prefab. The format is described in the kfx-prefab crate (model.rs).
format = 1
thumbnail = ""

[meta]
name = "Maze segment"
author = "KeeperFX Editor starter set"
description = "An eleven by eleven rock maze with an entrance west and an exit east and a gold seam in the middle."
tags = ["maze", "terrain", "gold"]
editor_version = "0.1.0"

[meta.requires]
creatures = []
objects = []
traps = []
doors = []
effect_generators = []
slabs = ["GOLD", "HARD", "PATH"]
config = []

[layout]
width = 11
height = 11
rows = [
  "###########",
  "__#_____#_#",
  "#_###_#_#_#",
  "#_____#_#_#",
  "#######_#_#",
  "#____$#___#",
  "#_#_#####_#",
  "#_#_____#_#",
  "#_###_###_#",
  "#___#______",
  "###########",
]

[[palette]]
char = "#"
slab = "HARD"
owner = "neutral"

[[palette]]
char = "_"
slab = "PATH"
owner = "neutral"

[[palette]]
char = "$"
slab = "GOLD"
owner = "neutral"
