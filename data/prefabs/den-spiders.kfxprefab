# KeeperFX Editor prefab. The format is described in the kfx-prefab crate (model.rs).
format = 1
thumbnail = ""

[meta]
name = "Neutral den: spiders"
author = "KeeperFX Editor starter set"
description = "A small cave with three wild spiders and two bags of gold, open to the south."
tags = ["neutral", "den", "creatures"]
editor_version = "0.1.0"

[meta.requires]
creatures = ["SPIDER"]
objects = ["GOLD_BAG"]
traps = []
doors = []
effect_generators = []
slabs = ["DIRT", "PATH"]
config = []

[layout]
width = 9
height = 9
rows = [
  "...:::...",
  ".::___::.",
  ".:_____:.",
  ":_______:",
  ":_______:",
  ":_______:",
  ".:_____:.",
  ".::___::.",
  "...:_:...",
]

[[palette]]
char = ":"
slab = "DIRT"
owner = "neutral"

[[palette]]
char = "_"
slab = "PATH"
owner = "neutral"

[[thing]]
class = "Creature"
model = "SPIDER"
owner = "neutral"
x = [13, 128]
y = [7, 128]
level = 3

[[thing]]
class = "Creature"
model = "SPIDER"
owner = "neutral"
x = [10, 128]
y = [10, 128]
level = 2

[[thing]]
class = "Object"
model = "GOLD_BAG"
owner = "neutral"
x = [19, 128]
y = [10, 128]

[[thing]]
class = "Object"
model = "GOLD_BAG"
owner = "neutral"
x = [7, 128]
y = [13, 128]

[[thing]]
class = "Creature"
model = "SPIDER"
owner = "neutral"
x = [16, 128]
y = [13, 128]
level = 2
