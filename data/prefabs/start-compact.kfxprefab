# KeeperFX Editor prefab. The format is described in the kfx-prefab crate (model.rs).
format = 1
thumbnail = ""

[meta]
name = "Dungeon start: compact"
author = "KeeperFX Editor starter set"
description = "A dungeon heart in a small walled hall with two imps and gold seams in the corners. Owner slot A."
tags = ["dungeon", "start", "heart"]
editor_version = "0.1.0"

[meta.requires]
creatures = ["IMP"]
objects = []
traps = []
doors = []
effect_generators = []
slabs = ["DIRT", "DRAPE_WALL", "GOLD", "HEART_PEDESTAL", "PAIR_WALL", "PRETTY_PATH", "TORCH_WALL", "TWINS_WALL", "WOMAN_WALL"]
config = []

[layout]
width = 11
height = 9
rows = [
  "$:::::::::$",
  ":WwAwwBwww:",
  ":W-------w:",
  ":w--HHH--w:",
  ":w--HHH--w:",
  ":A--HHH--B:",
  ":A-------B:",
  ":CBwAwBwwW:",
  "$:::::::::$",
]

[[palette]]
char = "$"
slab = "GOLD"
owner = "neutral"

[[palette]]
char = ":"
slab = "DIRT"
owner = "neutral"

[[palette]]
char = "W"
slab = "TORCH_WALL"
owner = "A"

[[palette]]
char = "w"
slab = "PAIR_WALL"
owner = "A"

[[palette]]
char = "A"
slab = "TWINS_WALL"
owner = "A"

[[palette]]
char = "B"
slab = "WOMAN_WALL"
owner = "A"

[[palette]]
char = "-"
slab = "PRETTY_PATH"
owner = "A"

[[palette]]
char = "H"
slab = "HEART_PEDESTAL"
owner = "A"

[[palette]]
char = "C"
slab = "DRAPE_WALL"
owner = "A"

[[thing]]
class = "Creature"
model = "IMP"
owner = "A"
x = [10, 128]
y = [7, 128]
level = 1

[[thing]]
class = "Creature"
model = "IMP"
owner = "A"
x = [22, 128]
y = [19, 128]
level = 1
