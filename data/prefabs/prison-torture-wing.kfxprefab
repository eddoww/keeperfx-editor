# KeeperFX Editor prefab. The format is described in the kfx-prefab crate (model.rs).
format = 1
thumbnail = ""

[meta]
name = "Prison and torture wing"
author = "KeeperFX Editor starter set"
description = "A prison and a torture chamber side by side, each with its own door onto a shared corridor, one door to the outside."
tags = ["prison", "torture", "rooms", "doors"]
editor_version = "0.1.0"

[meta.requires]
creatures = []
objects = []
traps = []
doors = ["WOOD"]
effect_generators = []
slabs = ["DIRT", "DOOR_WOODEN2", "DRAPE_WALL", "PAIR_WALL", "PATH", "PRETTY_PATH", "PRISON_AREA", "PRISON_WALL", "TORCH_WALL", "TORTURE_AREA", "TORTURE_WALL", "TWINS_WALL", "WOMAN_WALL"]
config = []

[layout]
width = 15
height = 9
rows = [
  ":::::::::::::::",
  ":WwwwwwABBBBBA:",
  ":wPPPPPBQQQQQB:",
  ":wPPPPPBQQQQQB:",
  ":wPPPPPBQQQQQB:",
  ":CwwwDwEBBDBBE:",
  ":C-----------E:",
  ":FEACAEDAWCFEA:",
  ":::::::_:::::::",
]

