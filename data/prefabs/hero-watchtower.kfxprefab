# KeeperFX Editor prefab. The format is described in the kfx-prefab crate (model.rs).
format = 1
thumbnail = ""

[meta]
name = "Hero outpost: watchtower"
author = "KeeperFX Editor starter set"
description = "A small walled hero post with a hero gate, a knight, an archer and a wizard. Hero owned (player 4); the gate number is renumbered on apply."
tags = ["hero", "outpost", "gate"]
editor_version = "0.1.0"

[meta.requires]
creatures = ["ARCHER", "KNIGHT", "WIZARD"]
objects = ["GUARDFLAG_WHITE", "HERO_GATE"]
traps = []
doors = []
effect_generators = []
slabs = ["DRAPE_WALL", "PAIR_WALL", "PRETTY_PATH", "TORCH_WALL", "TWINS_WALL", "WOMAN_WALL"]
config = []

[layout]
width = 7
height = 6
rows = [
  "WwAwwBw",
  "W-----A",
  "w-----w",
  "w-----w",
  "Aww-wCB",
  "...-...",
]

[[palette]]
char = "W"
slab = "TORCH_WALL"
owner = "keep:4"

[[palette]]
char = "w"
slab = "PAIR_WALL"
owner = "keep:4"

[[palette]]
char = "A"
slab = "TWINS_WALL"
owner = "keep:4"

[[palette]]
char = "B"
slab = "WOMAN_WALL"
owner = "keep:4"

[[palette]]
char = "-"
slab = "PRETTY_PATH"
owner = "keep:4"

[[palette]]
char = "C"
slab = "DRAPE_WALL"
owner = "keep:4"

[[thing]]
class = "Creature"
model = "KNIGHT"
owner = "keep:4"
x = [4, 128]
y = [4, 128]
level = 3

[[thing]]
class = "Creature"
model = "ARCHER"
owner = "keep:4"
x = [16, 128]
y = [4, 128]
level = 3

[[thing]]
class = "Object"
model = "HERO_GATE"
owner = "keep:4"
x = [10, 128]
y = [7, 128]
gate = "gate"

[[thing]]
class = "Object"
model = "GUARDFLAG_WHITE"
owner = "keep:4"
x = [4, 128]
y = [10, 128]

[[thing]]
class = "Creature"
model = "WIZARD"
owner = "keep:4"
x = [10, 128]
y = [10, 128]
level = 2
