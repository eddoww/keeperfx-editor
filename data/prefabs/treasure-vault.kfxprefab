# KeeperFX Editor prefab. The format is described in the kfx-prefab crate (model.rs).
format = 1
thumbnail = ""

[meta]
name = "Treasure vault with traps"
author = "KeeperFX Editor starter set"
description = "A nine by three treasury full of gold hoards behind a locked steel door, a trapped guard corridor and a wooden door to the outside."
tags = ["treasury", "traps", "doors", "vault"]
editor_version = "0.1.0"

[meta.requires]
creatures = []
objects = ["GOLD_HOARD_3"]
traps = ["ALARM", "BOULDER", "POISON_GAS"]
doors = ["STEEL", "WOOD"]
effect_generators = []
slabs = ["DIRT", "DOOR_STEEL2", "DOOR_WOODEN2", "DRAPE_WALL", "PAIR_WALL", "PATH", "PRETTY_PATH", "TORCH_WALL", "TREASURY_AREA", "TREASURY_WALL", "TWINS_WALL", "WOMAN_WALL"]
config = []

[layout]
width = 13
height = 10
rows = [
  ":::::::::::::",
  ":WwwwwwwwwwA:",
  ":wTTTTTTTTTw:",
  ":wTTTTTTTTTw:",
  ":wTTTTTTTTTw:",
  ":BwwwwDwwwwC:",
  ":B---------B:",
  ":E---------E:",
  ":ECACBdCECAC:",
  "::::::_::::::",
]

[[palette]]
char = ":"
slab = "DIRT"
owner = "neutral"

[[palette]]
char = "W"
slab = "TORCH_WALL"
owner = "A"

[[palette]]
char = "w"
slab = "TREASURY_WALL"
owner = "A"

[[palette]]
char = "A"
slab = "WOMAN_WALL"
owner = "A"

[[palette]]
char = "T"
slab = "TREASURY_AREA"
owner = "A"

[[palette]]
char = "B"
slab = "TWINS_WALL"
owner = "A"

[[palette]]
char = "D"
slab = "DOOR_STEEL2"
owner = "A"

[[palette]]
char = "C"
slab = "PAIR_WALL"
owner = "A"

[[palette]]
char = "-"
slab = "PRETTY_PATH"
owner = "A"

[[palette]]
char = "E"
slab = "DRAPE_WALL"
owner = "A"

[[palette]]
char = "d"
slab = "DOOR_WOODEN2"
owner = "A"

[[palette]]
char = "_"
slab = "PATH"
owner = "neutral"

