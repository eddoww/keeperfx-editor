# KeeperFX Editor prefab. The format is described in the kfx-prefab crate (model.rs).
format = 1
thumbnail = ""

[meta]
name = "Treasure island"
author = "KeeperFX Editor starter set"
description = "A path island in a lava lake with gold bags and a spellbook, reached by a bridge from the south."
tags = ["treasure", "lava", "island", "bridge"]
editor_version = "0.1.0"

[meta.requires]
creatures = []
objects = ["GOLD_BAG", "SPELLBOOK_SOE"]
traps = []
doors = []
effect_generators = []
slabs = ["BRIDGE_FRAME", "HARD", "LAVA", "PATH"]
config = []

[layout]
width = 13
height = 11
rows = [
  "...#######...",
  "..#^^^^^^^#..",
  ".#^^^^^^^^^#.",
  "#^^^^___^^^^#",
  "#^^^^___^^^^#",
  "#^^^^___^^^^#",
  "#^^^^^+^^^^^#",
  "#^^^^^+^^^^^#",
  ".#^^^^+^^^^#.",
  "..#_______#..",
  "...###_###...",
]

[[palette]]
char = "#"
slab = "HARD"
owner = "neutral"

[[palette]]
char = "^"
slab = "LAVA"
owner = "neutral"

[[palette]]
char = "_"
slab = "PATH"
owner = "neutral"

[[palette]]
char = "+"
slab = "BRIDGE_FRAME"
owner = "neutral"
wlb = 1

[[thing]]
class = "Object"
model = "GOLD_BAG"
owner = "neutral"
x = [16, 128]
y = [10, 128]

[[thing]]
class = "Object"
model = "SPELLBOOK_SOE"
owner = "neutral"
x = [19, 128]
y = [13, 128]

[[thing]]
class = "Object"
model = "GOLD_BAG"
owner = "neutral"
x = [22, 128]
y = [13, 128]
